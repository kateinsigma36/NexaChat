# Переменные окружения для NexaChat Server

# Порт сервера
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexachat

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT секреты
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (для восстановления пароля)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=NexaChat <noreply@nexachat.com>

# Frontend URL (для CORS)
CLIENT_URL=http://localhost:5173

# Загрузка файлов
MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads

# TURN сервер (для WebRTC)
TURN_HOST=your-turn-server.com
TURN_USERNAME=nexachat
TURN_PASSWORD=your-turn-password

# Firebase Cloud Messaging (для push-уведомлений)
FCM_SERVER_KEY=your-fcm-server-key
